// optimizes ("vecmath.cc:418")
// Triple 16x16 tiled matmul accumulate.

search
    const int i = int(gl_GlobalInvocationID.x);
    if (i >= rllm_bound_x) return;
    const int j = int(gl_GlobalInvocationID.y);
    if (j >= rllm_bound_y) return;
    float sum1 = 0.f;
    float sum2 = 0.f;
    float sum3 = 0.f;
    for (int l_idx = 0; l_idx < wildcard(N); ++l_idx)
    {
        const int k = int(l_idx);
        const float term1 = (A1[i, k] * B1[k, j]);
        OVERFLOW_CHECK_ADD(sum1, term1);
        sum1 += term1;
        const float term2 = (A2[i, k] * B2[k, j]);
        OVERFLOW_CHECK_ADD(sum2, term2);
        sum2 += term2;
        const float term3 = (A3[i, k] * B3[k, j]);
        OVERFLOW_CHECK_ADD(sum3, term3);
        sum3 += term3;
    }
    const float raw = (C[i, j] + (sum1 + (sum2 + sum3)));
    C[i, j] = clamp(raw, -10000.0f, 10000.0f);

replace
    const int i = int(gl_GlobalInvocationID.x);
    const int j = int(gl_GlobalInvocationID.y);
    const int rllm_lx = int(gl_LocalInvocationID.x);
    const int rllm_ly = int(gl_LocalInvocationID.y);
    float sum1 = 0.f;
    float sum2 = 0.f;
    float sum3 = 0.f;
    shared float rllm_tile_a1[256];
    shared float rllm_tile_b1[256];
    shared float rllm_tile_a2[256];
    shared float rllm_tile_b2[256];
    shared float rllm_tile_a3[256];
    shared float rllm_tile_b3[256];

    const int rllm_tile_count = ((wildcard(N) + 15) / 16);
    for (int rllm_tile_index = 0; rllm_tile_index < rllm_tile_count; ++rllm_tile_index)
    {
        const int rllm_tile = (rllm_tile_index * 16);
        const int rllm_a_k = (rllm_tile + rllm_ly);
        const int rllm_b_k = (rllm_tile + rllm_lx);
        const int rllm_slot = ((rllm_lx * 16) + rllm_ly);
        rllm_tile_a1[rllm_slot] = 0.f;
        rllm_tile_b1[rllm_slot] = 0.f;
        rllm_tile_a2[rllm_slot] = 0.f;
        rllm_tile_b2[rllm_slot] = 0.f;
        rllm_tile_a3[rllm_slot] = 0.f;
        rllm_tile_b3[rllm_slot] = 0.f;
        if ((i < rllm_bound_x) && (rllm_a_k < wildcard(N)))
        {
            rllm_tile_a1[rllm_slot] = A1[i, rllm_a_k];
            rllm_tile_a2[rllm_slot] = A2[i, rllm_a_k];
            rllm_tile_a3[rllm_slot] = A3[i, rllm_a_k];
        }
        if ((j < rllm_bound_y) && (rllm_b_k < wildcard(N)))
        {
            rllm_tile_b1[rllm_slot] = B1[rllm_b_k, j];
            rllm_tile_b2[rllm_slot] = B2[rllm_b_k, j];
            rllm_tile_b3[rllm_slot] = B3[rllm_b_k, j];
        }
        barrier();
        for (int rllm_k = 0; rllm_k < 16; ++rllm_k)
        {
            const int rllm_a_slot = ((rllm_lx * 16) + rllm_k);
            const int rllm_b_slot = ((rllm_k * 16) + rllm_ly);
            sum1 += (rllm_tile_a1[rllm_a_slot] * rllm_tile_b1[rllm_b_slot]);
            sum2 += (rllm_tile_a2[rllm_a_slot] * rllm_tile_b2[rllm_b_slot]);
            sum3 += (rllm_tile_a3[rllm_a_slot] * rllm_tile_b3[rllm_b_slot]);
        }
        barrier();
    }
    if ((i < rllm_bound_x) && (j < rllm_bound_y))
    {
        const float raw = (C[i, j] + (sum1 + (sum2 + sum3)));
        C[i, j] = clamp(raw, -10000.0f, 10000.0f);
    }
