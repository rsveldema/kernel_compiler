// optimizes ("vecmath.cc:389")
// 16x16 tiled matmul accumulate: C[i,j] += A[i,k] * B[k,j].

search
    const int i = int(gl_GlobalInvocationID.x);
    if (i >= rllm_bound_x) return;
    const int j = int(gl_GlobalInvocationID.y);
    if (j >= rllm_bound_y) return;

    float sum = 0.f;
    for (int l_idx = 0; l_idx < wildcard(N); ++l_idx)
    {
        const int k = int(l_idx);
        const float term = (A[i, k] * B[k, j]);
        OVERFLOW_CHECK_ADD(sum, term);
        sum += term;
    }
    const float raw = (C[i, j] + sum);
    C[i, j] = clamp(raw, -10000.0f, 10000.0f);

replace
    const int i = int(gl_GlobalInvocationID.x);
    const int j = int(gl_GlobalInvocationID.y);
    const int rllm_lx = int(gl_LocalInvocationID.x);
    const int rllm_ly = int(gl_LocalInvocationID.y);
    float sum = 0.f;
    shared float rllm_tile_a[256];
    shared float rllm_tile_b[256];

    const int rllm_tile_count = ((wildcard(N) + 15) / 16);
    for (int rllm_tile_index = 0; rllm_tile_index < rllm_tile_count; ++rllm_tile_index)
    {
        const int rllm_tile = (rllm_tile_index * 16);
        const int rllm_a_k = (rllm_tile + rllm_ly);
        const int rllm_b_k = (rllm_tile + rllm_lx);
        const int rllm_slot = ((rllm_lx * 16) + rllm_ly);
        rllm_tile_a[rllm_slot] = 0.f;
        rllm_tile_b[rllm_slot] = 0.f;
        if ((i < rllm_bound_x) && (rllm_a_k < wildcard(N)))
            rllm_tile_a[rllm_slot] = A[i, rllm_a_k];
        if ((j < rllm_bound_y) && (rllm_b_k < wildcard(N)))
            rllm_tile_b[rllm_slot] = B[rllm_b_k, j];
        barrier();
        for (int rllm_k = 0; rllm_k < 16; ++rllm_k)
            sum += (rllm_tile_a[((rllm_lx * 16) + rllm_k)] * rllm_tile_b[((rllm_k * 16) + rllm_ly)]);
        barrier();
    }
    if ((i < rllm_bound_x) && (j < rllm_bound_y))
    {
        const float raw = (C[i, j] + sum);
        C[i, j] = clamp(raw, -10000.0f, 10000.0f);
    }
