replace
    const int row = int(gl_GlobalInvocationID.x);
    if (row >= rllm_bound_x) return;
    const int col = int(gl_GlobalInvocationID.y);
    if (col >= rllm_bound_y) return;
    float sum = 0.f;
    for (int l_idx = 0; l_idx < wildcard(N); ++l_idx)
    {
        const int k = int(l_idx);
        const float term = (update[row, k] * update[col, k]);
        OVERFLOW_CHECK_ADD(sum, term);
        sum += term;
    }
